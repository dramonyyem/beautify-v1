{
  "name": "@beautify/beaufity-v1",
  "version": "1.0.0",
  "description": "Pointhub Vue component library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build",
    "build:lib": "vite build --mode production",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "prepare": "npm run build:lib"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
